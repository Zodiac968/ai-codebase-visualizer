# Application Configuration
APP_NAME="AI Codebase Visualizer API"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# PostgreSQL Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/codebase_visualizer"

# Neo4j Configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# Repository Storage & Ingestion Safeguards
REPOSITORY_STORAGE_PATH="./data/repos"
MAX_REPOSITORY_SIZE_MB=50
MAX_REPOSITORY_FILES=2000
GIT_CLONE_TIMEOUT_SECONDS=120

# Future Phase Placeholders (Not required for Phase 1)
GROQ_API_KEY=""
JWT_SECRET="dev_secret_key_change_in_production_1234567890"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
