# Repository analysis limits
SUPPORTED_EXTENSIONS=.js,.jsx,.ts,.tsx,.py
MAX_REPOSITORY_SIZE_MB=200
MAX_FILE_COUNT=5000
MAX_FILE_SIZE_MB=2

# PostgreSQL (pgvector)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Phase 4.6: Groq Q&A (server-side only, never exposed to the frontend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STRICT_SCHEMA=true
GROQ_TEMPERATURE=0.1
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_REASONING_EFFORT=medium
GROQ_CONTEXT_WINDOW=131072
GROQ_TIMEOUT_MS=45000
GROQ_MAX_RETRIES=2

# Phase 4.6: Q&A retrieval budget
QA_SEED_LIMIT=6
QA_MAX_DEPTH=1
QA_MAX_EXPANDED_NODES=12
QA_MAX_TOTAL_SYMBOLS=18
QA_MAX_CONTEXT_TOKENS=12000
QA_MAX_CONCURRENT_REQUESTS=2
